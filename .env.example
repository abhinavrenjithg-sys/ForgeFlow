# ForgeFlow Environment Configuration Example

# Security
SECRET_KEY=forgeflow-super-secret-dev-jwt-key-2026-secure-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite zero-config development:
DATABASE_URL=sqlite:///./forgeflow.db
# PostgreSQL Docker production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgeflow

# AI Task Planner Engine
# Options: 'mock' (deterministic offline demonstration mode), 'openai', 'gemini'
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
